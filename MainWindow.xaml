<Window x:Class="TraceZero.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:TraceZero.Models"
        mc:Ignorable="d"
        Icon="Assets/TraceZero.ico"
        Width="860"
        Height="600"
        MinWidth="680"
        MinHeight="460"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Loaded="Window_Loaded"
        Drop="Window_Drop"
        PreviewDragOver="Window_PreviewDragOver">
    <Window.Resources>
        <!-- Palette -->
        <SolidColorBrush x:Key="WindowBrush" Color="#F3F5F9" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E8EF" />
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF0FF" />
        <SolidColorBrush x:Key="DangerBrush" Color="#E11D48" />
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#BE123C" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#F1F3F8" />
        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6366F1" Offset="0" />
            <GradientStop Color="#8B5CF6" Offset="1" />
        </LinearGradientBrush>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <!-- White card with a soft shadow. The shadow sits on its own layer so text stays sharp. -->
        <Style x:Key="CardStyle" TargetType="ContentControl">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="1" Direction="270" Opacity="0.06" Color="#1E293B" />
                                </Border.Effect>
                            </Border>
                            <Border Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <!-- Buttons: Tag holds a Segoe MDL2 glyph. With no Content the button is icon-only, so give it a ToolTip. -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="Icon"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="13"
                                           Margin="0,0,7,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="Icon" Property="Margin" Value="0" />
                            </Trigger>
                            <!-- Keyboard focus stays visible without the dotted default rectangle. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SecondaryHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4338CA" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DangerHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DangerHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8EBF2" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="#E8EBF2" />
                            <Border x:Name="PART_Indicator"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource BrandGradient}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- File table -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F5" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="ColumnHeaderHeight" Value="30" />
            <Setter Property="RowHeight" Value="44" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F7F8FC" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- The safety note lives in a tooltip to keep the window small. -->
                <Button Tag="&#xE946;"
                        Style="{StaticResource GhostButtonStyle}"
                        AutomationProperties.Name="{Binding Ui[SafetyTitle]}"
                        ToolTipService.ShowDuration="60000">
                    <Button.ToolTip>
                        <StackPanel MaxWidth="320">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Ui[SafetyTitle]}" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Ui[SafetyBody]}" />
                        </StackPanel>
                    </Button.ToolTip>
                </Button>
                <Button Margin="2,0,0,0"
                        Content="{Binding Ui[LanguageToggle]}"
                        Tag="&#xE774;"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="ToggleLanguageButton_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource BrandGradient}">
                    <TextBlock FontFamily="{StaticResource IconFont}"
                               FontSize="14"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="&#xEA18;" />
                </Border>
                <TextBlock Margin="10,0,0,0"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Text="{Binding Ui[AppTitle]}" />
                <TextBlock Margin="8,2,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionStyle}"
                           Text="{Binding VersionText}" />
            </StackPanel>
        </DockPanel>

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{Binding Ui[WipeFreeSpaceButton]}"
                        Tag="&#xE75C;"
                        Click="WipeFreeSpaceButton_Click"
                        IsEnabled="{Binding CanEditQueue}" />
                <Button Margin="6,0,0,0"
                        Tag="&#xE74E;"
                        ToolTip="{Binding Ui[SaveLogButton]}"
                        AutomationProperties.Name="{Binding Ui[SaveLogButton]}"
                        Click="SaveLogButton_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button Content="{Binding Ui[AddFilesButton]}"
                        Tag="&#xE710;"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="AddFilesButton_Click"
                        IsEnabled="{Binding CanEditQueue}" />
                <Button Margin="6,0,0,0"
                        Tag="&#xE738;"
                        ToolTip="{Binding Ui[RemoveSelectedButton]}"
                        AutomationProperties.Name="{Binding Ui[RemoveSelectedButton]}"
                        Click="RemoveSelectedButton_Click"
                        IsEnabled="{Binding CanEditQueue}" />
                <Button Margin="6,0,0,0"
                        Tag="&#xE73E;"
                        ToolTip="{Binding Ui[ClearCompletedButton]}"
                        AutomationProperties.Name="{Binding Ui[ClearCompletedButton]}"
                        Click="ClearCompletedButton_Click"
                        IsEnabled="{Binding CanEditQueue}" />
                <Button Margin="6,0,0,0"
                        Tag="&#xE74D;"
                        ToolTip="{Binding Ui[ClearAllButton]}"
                        AutomationProperties.Name="{Binding Ui[ClearAllButton]}"
                        Click="ClearAllButton_Click"
                        IsEnabled="{Binding CanEditQueue}" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionStyle}"
                           Text="{Binding SummaryText}" />
            </StackPanel>
        </DockPanel>

        <!-- File list -->
        <ContentControl Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource CardStyle}" Padding="2,4,2,2">
            <Grid>
                <DataGrid x:Name="FileGrid"
                          ItemsSource="{Binding Files}"
                          AutoGenerateColumns="False"
                          SelectionChanged="FileGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="NameColumn" Width="*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:FileDeletionItem}">
                                    <DockPanel VerticalAlignment="Center" ToolTip="{Binding FullPath}">
                                        <TextBlock DockPanel.Dock="Left"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource SubtleBrush}"
                                                   VerticalAlignment="Center"
                                                   Text="&#xE8A5;" />
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Name}" />
                                            <TextBlock FontSize="11"
                                                       Foreground="{StaticResource SubtleBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding FullPath}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="SizeColumn"
                                            Binding="{Binding SizeText}"
                                            SortMemberPath="Size"
                                            Width="84">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Setter Property="FontSize" Value="12" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn x:Name="StatusColumn" Width="170" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <!-- Default colours mean "in progress"; finished and waiting states override them. -->
                                <DataTemplate DataType="{x:Type models:FileDeletionItem}">
                                    <Border x:Name="Pill"
                                            HorizontalAlignment="Left"
                                            CornerRadius="9"
                                            Padding="8,2"
                                            Background="#EEF0FF"
                                            ToolTip="{Binding Status}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="Dot"
                                                     Width="6"
                                                     Height="6"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"
                                                     Fill="#4F46E5" />
                                            <TextBlock x:Name="Label"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#4338CA"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="128"
                                                       Text="{Binding Status}" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static models:FileQueueStatusKind.Queued}">
                                            <Setter TargetName="Pill" Property="Background" Value="#F1F3F7" />
                                            <Setter TargetName="Dot" Property="Fill" Value="#94A3B8" />
                                            <Setter TargetName="Label" Property="Foreground" Value="#475569" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static models:FileQueueStatusKind.Missing}">
                                            <Setter TargetName="Pill" Property="Background" Value="#F1F3F7" />
                                            <Setter TargetName="Dot" Property="Fill" Value="#94A3B8" />
                                            <Setter TargetName="Label" Property="Foreground" Value="#475569" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static models:FileQueueStatusKind.Cancelled}">
                                            <Setter TargetName="Pill" Property="Background" Value="#F1F3F7" />
                                            <Setter TargetName="Dot" Property="Fill" Value="#94A3B8" />
                                            <Setter TargetName="Label" Property="Foreground" Value="#475569" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static models:FileQueueStatusKind.Completed}">
                                            <Setter TargetName="Pill" Property="Background" Value="#E7F7EF" />
                                            <Setter TargetName="Dot" Property="Fill" Value="#059669" />
                                            <Setter TargetName="Label" Property="Foreground" Value="#047857" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static models:FileQueueStatusKind.CompletedWithResidue}">
                                            <Setter TargetName="Pill" Property="Background" Value="#FEF6E7" />
                                            <Setter TargetName="Dot" Property="Fill" Value="#D97706" />
                                            <Setter TargetName="Label" Property="Foreground" Value="#B45309" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static models:FileQueueStatusKind.Failed}">
                                            <Setter TargetName="Pill" Property="Background" Value="#FDECEF" />
                                            <Setter TargetName="Dot" Property="Fill" Value="#E11D48" />
                                            <Setter TargetName="Label" Property="Foreground" Value="#BE123C" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state: a drop zone -->
                <Grid Background="{StaticResource CardBrush}" Visibility="{Binding EmptyQueueVisibility}">
                    <Rectangle Margin="10"
                               RadiusX="8"
                               RadiusY="8"
                               Fill="#FAFBFD"
                               Stroke="#CBD2DE"
                               StrokeThickness="1.5"
                               StrokeDashArray="5 4" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                        <TextBlock HorizontalAlignment="Center"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="26"
                                   Foreground="{StaticResource AccentBrush}"
                                   Text="&#xE898;" />
                        <TextBlock Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding Ui[QueueEmpty]}" />
                        <TextBlock Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="{Binding Ui[QueueDropHint]}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ContentControl>

        <!-- Progress and run -->
        <ContentControl Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource CardStyle}" Padding="14,10,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Margin="8,0,0,0"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Text="{Binding OverallProgress, StringFormat={}{0:0}%}" />
                        <TextBlock FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding StatusText}"
                                   Text="{Binding StatusText}" />
                    </DockPanel>
                    <ProgressBar Margin="0,7,0,0"
                                 Maximum="100"
                                 Value="{Binding OverallProgress, Mode=OneWay}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Margin="16,0,0,0"
                        Height="38"
                        Content="{Binding Ui[CancelDeleteButton]}"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="CancelDeleteButton_Click"
                        IsEnabled="{Binding CanCancelDeletion}" />
                <Button Grid.Column="2"
                        Margin="6,0,0,0"
                        Content="{Binding Ui[StartDeleteButton]}"
                        Tag="&#xEA18;"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="StartDeleteButton_Click"
                        IsEnabled="{Binding CanStartDeletion}" />
            </Grid>
        </ContentControl>

        <!-- Log, collapsed by default -->
        <Expander Grid.Row="4"
                  Margin="0,8,0,0"
                  Foreground="{StaticResource MutedBrush}"
                  FontSize="12">
            <Expander.Header>
                <TextBlock FontWeight="SemiBold" Text="{Binding Ui[LogTitle]}" />
            </Expander.Header>
            <ContentControl Margin="0,6,0,0" Style="{StaticResource CardStyle}" Padding="6">
                <ListBox Height="110"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="#475569"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="11.5"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding LogEntries}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" ToolTip="{Binding}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,1" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </ContentControl>
        </Expander>
    </Grid>
</Window>
