<Window x:Class="SecureFileEraser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Width="1160"
        Height="700"
        MinWidth="940"
        MinHeight="560"
        Background="#E7ECEF"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Loaded="Window_Loaded"
        Drop="Window_Drop"
        PreviewDragOver="Window_PreviewDragOver">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#F8FAFB" />
        <SolidColorBrush x:Key="CardAltBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="HeaderBrush" Color="#112235" />
        <SolidColorBrush x:Key="AccentBrush" Color="#137A6A" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#0F6658" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5C6D7D" />
        <SolidColorBrush x:Key="LineBrush" Color="#CFDAE2" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#102033" />
            <Setter Property="Background" Value="#DDE6ED" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CEDAE3" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#24384E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="10,6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D4864" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#102033" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="ColumnHeaderHeight" Value="32" />
            <Setter Property="RowHeight" Value="30" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF3F6" />
            <Setter Property="Foreground" Value="#304255" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="9,6" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFCFD" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCEEEF" />
                    <Setter Property="Foreground" Value="#0D2231" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="145" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <WrapPanel DockPanel.Dock="Right"
                           HorizontalAlignment="Right">
                    <Button Content="{Binding Ui[LanguageToggle]}"
                            Style="{StaticResource HeaderButtonStyle}"
                            Click="ToggleLanguageButton_Click" />
                    <Button Content="{Binding Ui[HomepageButton]}"
                            Style="{StaticResource HeaderButtonStyle}"
                            Click="HomepageButton_Click" />
                    <Button Content="{Binding Ui[DonateButton]}"
                            Style="{StaticResource HeaderButtonStyle}"
                            Click="DonateButton_Click" />
                </WrapPanel>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="{Binding Ui[AppTitle]}" />
                    <Border Background="#1D3147"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="12,0,0,0">
                        <TextBlock Foreground="#D5E4F0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="{Binding VersionText}" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource CardAltBrush}"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               Margin="0,0,0,8">
                        <Border DockPanel.Dock="Right"
                                Background="#E6F4EF"
                                CornerRadius="6"
                                Padding="10,5">
                            <TextBlock FontWeight="Bold"
                                       Foreground="#0F6658"
                                       Text="{Binding SummaryText}" />
                        </Border>

                        <TextBlock FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#102033"
                                   VerticalAlignment="Center"
                                   Text="{Binding Ui[QueueTitle]}" />
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="FileGrid"
                                  ItemsSource="{Binding Files}"
                                  AutoGenerateColumns="False"
                                  SelectionChanged="FileGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="NameColumn"
                                                    Binding="{Binding Name}"
                                                    Width="180" />
                                <DataGridTextColumn x:Name="PathColumn"
                                                    Binding="{Binding FullPath}"
                                                    Width="*" />
                                <DataGridTextColumn x:Name="SizeColumn"
                                                    Binding="{Binding SizeText}"
                                                    Width="100" />
                                <DataGridTextColumn x:Name="StatusColumn"
                                                    Binding="{Binding Status}"
                                                    Width="145" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Margin="20"
                                   Visibility="{Binding EmptyQueueVisibility}"
                                   Panel.ZIndex="2"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="#7E91A5"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="{Binding Ui[QueueEmpty]}" />
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#102033"
                                   Text="{Binding Ui[OverviewTitle]}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding Ui[OverviewQueueLabel]}" />
                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       FontWeight="Bold"
                                       Text="{Binding SummaryText}" />

                            <TextBlock Grid.Row="1"
                                       Margin="0,7,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding Ui[OverviewProgressLabel]}" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Margin="0,7,0,0"
                                       HorizontalAlignment="Right"
                                       FontWeight="SemiBold"
                                       Text="{Binding StatusText}" />

                            <TextBlock Grid.Row="2"
                                       Margin="0,7,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding Ui[OverviewVersionLabel]}" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Margin="0,7,0,0"
                                       HorizontalAlignment="Right"
                                       FontWeight="SemiBold"
                                       Text="{Binding VersionText}" />
                        </Grid>

                        <ProgressBar Margin="0,12,0,0"
                                     Height="9"
                                     Maximum="100"
                                     Value="{Binding OverallProgress, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="8"
                        Padding="12">
                    <StackPanel>
                        <TextBlock FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#102033"
                                   Text="{Binding Ui[ActionsTitle]}" />

                        <UniformGrid Margin="0,10,0,0"
                                     Columns="2">
                            <Button Content="{Binding Ui[AddFilesButton]}"
                                    Click="AddFilesButton_Click"
                                    IsEnabled="{Binding CanEditQueue}" />
                            <Button Content="{Binding Ui[RemoveSelectedButton]}"
                                    Click="RemoveSelectedButton_Click"
                                    IsEnabled="{Binding CanEditQueue}" />
                            <Button Content="{Binding Ui[ClearCompletedButton]}"
                                    Click="ClearCompletedButton_Click"
                                    IsEnabled="{Binding CanEditQueue}" />
                            <Button Content="{Binding Ui[ClearAllButton]}"
                                    Click="ClearAllButton_Click"
                                    IsEnabled="{Binding CanEditQueue}" />
                            <Button Content="{Binding Ui[WipeFreeSpaceButton]}"
                                    Click="WipeFreeSpaceButton_Click"
                                    IsEnabled="{Binding CanEditQueue}" />
                            <Button Content="{Binding Ui[SaveLogButton]}"
                                    Click="SaveLogButton_Click" />
                        </UniformGrid>

                        <UniformGrid Margin="0,8,0,0"
                                     Columns="2">
                            <Button Content="{Binding Ui[StartDeleteButton]}"
                                    Click="StartDeleteButton_Click"
                                    IsEnabled="{Binding CanStartDeletion}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="{Binding Ui[CancelDeleteButton]}"
                                    Click="CancelDeleteButton_Click"
                                    IsEnabled="{Binding CanCancelDeletion}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource CardAltBrush}"
                CornerRadius="8"
                Padding="10"
                Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="16"
                           FontWeight="Bold"
                           Foreground="#102033"
                           Text="{Binding Ui[LogTitle]}" />

                <ListBox Grid.Row="1"
                         Margin="0,8,0,0"
                         BorderThickness="0"
                         Background="#F4F8FA"
                         Foreground="#102033"
                         FontFamily="Consolas"
                         FontSize="12"
                         ItemsSource="{Binding LogEntries}" />
            </Grid>
        </Border>
    </Grid>
</Window>
